enum StoryReviewType {
  create
  update
  delete
}

enum StoryReviewStatus {
  pending
  approved
  rejected
}

model StoryReview {
  id String @id @default(cuid())

  type   StoryReviewType
  status StoryReviewStatus @default(pending)

  // Snapshot of the proposed story data (full JSON for create/update, null for delete)
  proposedData Json? // Full story payload
  previousData Json? // Snapshot of current story state before change (for update/delete)

  // Story reference (null for create since story doesn't exist yet)
  storyId String?
  story   Story?  @relation("StoryReviews", fields: [storyId], references: [id], onDelete: SetNull)

  // Submitter
  submittedById String
  submittedBy   User     @relation("StoryReviewSubmitter", fields: [submittedById], references: [id])
  submittedAt   DateTime @default(now())

  // Reviewer (filled on approve/reject)
  reviewedById String?
  reviewedBy   User?     @relation("StoryReviewReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  // Reviewer feedback
  reviewNote   String?  @db.Text
  reviewImages String[] // uploadthing URLs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Audit log entries
  auditLogs StoryReviewAuditLog[]

  @@index([status])
  @@index([type])
  @@index([storyId])
  @@index([submittedById])
  @@index([reviewedById])
  @@index([createdAt])
  @@map("story_reviews")
}

model StoryReviewAuditLog {
  id String @id @default(cuid())

  action   String // submitted, approved, rejected, cancelled
  note     String? @db.Text
  metadata Json? // Any extra context

  performedById String
  performedBy   User   @relation("StoryReviewAuditPerformer", fields: [performedById], references: [id])

  reviewId String
  review   StoryReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([reviewId])
  @@index([performedById])
  @@index([action])
  @@index([createdAt])
  @@map("story_review_audit_logs")
}
