// Lý do báo cáo
enum ReportReason {
  misleading_offer // Ưu đãi sai sự thật
  fake_location // Điểm cầu giả / không tồn tại
  spam_review // Đánh giá spam / ảo
  inappropriate_content // Nội dung không phù hợp
  closed_business // Điểm cầu đã đóng cửa vĩnh viễn
  other // Lý do khác
}

// Trạng thái xử lý báo cáo
enum LocationReportStatus {
  open // Mới tạo — chưa xử lý
  triaging // Admin đang xem xét
  resolved // Đã xử lý
  dismissed // Bác bỏ (không có cơ sở)
}

// Báo cáo vi phạm từ người dùng hoặc khách vãng lai về một điểm cầu (kho)
//
// ⚠ Trước 07/09/2026 đây là bảng báo cáo vi phạm của "địa điểm kinh doanh".
//
// ⚠ `reviewId` và `offerTemplateId` NAY LÀ KHOÁ NGOẠI THẬT, trước chỉ là hai
// cột chuỗi trần. Cột trần nghĩa là xoá một đánh giá hay một ưu đãi sẽ để lại
// báo cáo trỏ vào hư không, và người trực hàng đợi mở ra thấy trang trắng mà
// không có gì giải thích. `SetNull` giữ đúng ngữ nghĩa: báo cáo VẪN CÒN GIÁ TRỊ
// khi đối tượng bị gỡ (nó chính là lý do đối tượng bị gỡ), chỉ mất đường dẫn tới.
model WarehouseViolationReport {
  id String @id @default(cuid())

  // Người báo cáo (một trong hai)
  reportedById         String? // User đăng nhập
  reportedBy           User?   @relation("UserReportsSubmitted", fields: [reportedById], references: [id], onDelete: SetNull)
  reportedGuestContact String? // Email / phone của khách vãng lai (tùy chọn)

  // Đối tượng bị báo cáo
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  reviewId String? // Báo cáo cụ thể một đánh giá điểm cầu
  review   DiemCauReview? @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  offerTemplateId String? // Báo cáo cụ thể một ưu đãi
  offerTemplate   VoucherTemplate? @relation("VoucherTemplateViolationReports", fields: [offerTemplateId], references: [id], onDelete: SetNull)

  // Nội dung
  reason      ReportReason
  description String?      @db.Text

  // Xử lý
  status           LocationReportStatus @default(open)
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolvedBy       User?                @relation("UserReportsResolved", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolutionNote   String?              @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([warehouseId, status])
  @@index([status, createdAt(sort: Desc)])
  @@index([reportedById])
  @@index([reviewId])
  @@index([offerTemplateId])
  @@map("warehouse_violation_reports")
}
