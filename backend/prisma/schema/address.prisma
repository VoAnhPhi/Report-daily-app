model Address {
  id String @id @default(uuid())

  // Basic address information
  name     String // Display name for the address (e.g., "Home", "Office")
  type     String // Type: 'home', 'work', 'other'
  fullName String // Full name of the recipient
  phone    String // Phone number

  // Address components
  street     String // Street address
  ward       String? // Ward/Neighborhood (for detailed addressing)
  district   String? // District (for detailed addressing)
  city       String? // City
  state      String? // State/Province (optional for international addresses)
  country    String? // Country
  postalCode String? // Postal/ZIP code

  note String? // Optional note for the address (e.g., "Leave at the front door", "Detail location for delivery")

  // Google Places API fields (for future implementation)
  placeId          String? // Google Places ID
  latitude         Float? // Latitude coordinate
  longitude        Float? // Longitude coordinate
  formattedAddress String? // Google-formatted address

  // GHN shipping metadata (cached for faster fee calculation)
  /// provinceId: number | null
  /// districtId: number | null
  /// wardCode: string | null
  /// provinceName: string | null
  /// districtName: string | null
  /// wardName: string | null
  metadata Json? // Store GHN codes and names for optimized shipping fee calculation

  // User settings
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  warehouse Warehouse?

  @@map("addresses")
}
