model ActivityLog {
  id String @id @default(cuid())

  description String? // Optional description
  changes     Json? // Optional structured diff (before/after snapshots)

  targetId     String
  targetType   ActivityTargetType
  activityType ActivityType

  uploaderId String
  uploader   User   @relation("UserActivities", fields: [uploaderId], references: [id], onDelete: Cascade)

  // Structured context for production querying
  metadata     Json? // Arbitrary structured context (storyId, draftId, mediaId, etc.)
  requestId    String? // Correlation ID for tracing requests across services
  ipAddress    String? // Client IP (PII-safe: hashed or masked in production)
  userAgent    String? // Client user-agent string
  source       String? // Surface: "web" | "mobile" | "admin" | "api" | "cron" | "worker"
  resultStatus String? // "success" | "failure" | "cancelled" | "partial"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Index: targetType+targetId for entity history, uploaderId for user history,
  // activityType for event-type queries, requestId for correlation tracing
  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([uploaderId, createdAt(sort: Desc)])
  @@index([activityType, createdAt(sort: Desc)])
  @@index([createdAt])
  @@index([requestId])
  @@index([source, createdAt(sort: Desc)])
  @@map("activity_logs")
}
