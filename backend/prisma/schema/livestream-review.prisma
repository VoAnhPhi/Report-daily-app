enum LivestreamReviewType {
  create
  update
  delete
}

enum LivestreamReviewStatus {
  pending
  approved
  rejected
}

model LivestreamReview {
  id String @id @default(cuid())

  type   LivestreamReviewType
  status LivestreamReviewStatus @default(pending)

  // Snapshot of the proposed livestream data (full JSON for create/update, null for delete)
  proposedData Json? // Full livestream payload
  previousData Json? // Snapshot of current livestream state before change (for update/delete)

  // LiveStream reference (null for create since livestream doesn't exist yet)
  livestreamId String?
  livestream   LiveStream? @relation(fields: [livestreamId], references: [id], onDelete: SetNull)

  // Submitter
  submittedById String
  submittedBy   User     @relation("LivestreamReviewSubmitter", fields: [submittedById], references: [id])
  submittedAt   DateTime @default(now())

  // Reviewer (filled on approve/reject)
  reviewedById String?
  reviewedBy   User?     @relation("LivestreamReviewReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  // Reviewer feedback
  reviewNote   String?  @db.Text
  reviewImages String[] // uploadthing URLs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Audit log entries
  auditLogs LivestreamReviewAuditLog[]

  @@index([status])
  @@index([type])
  @@index([livestreamId])
  @@index([submittedById])
  @@index([reviewedById])
  @@index([createdAt])
  @@map("livestream_reviews")
}

model LivestreamReviewAuditLog {
  id String @id @default(cuid())

  action   String // submitted, approved, rejected, cancelled
  note     String? @db.Text
  metadata Json? // Any extra context

  performedById String
  performedBy   User   @relation("LivestreamReviewAuditPerformer", fields: [performedById], references: [id])

  reviewId String
  review   LivestreamReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([reviewId])
  @@index([performedById])
  @@index([action])
  @@index([createdAt])
  @@map("livestream_review_audit_logs")
}
