  businessClaims                 BusinessClaim[]               @relation("UserClaims")
  businessClaimsReviewed         BusinessClaim[]               @relation("UserClaimsReviewed")
  businessComplianceDocsVerified BusinessComplianceDoc[]       @relation("DocVerifier")
  businessComplianceReviewed     BusinessComplianceChecklist[] @relation("ComplianceReviewer")
  locationReportsSubmitted       WarehouseViolationReport[]    @relation("UserReportsSubmitted")
  locationReportsResolved        WarehouseViolationReport[]    @relation("UserReportsResolved")
  savedPlaces                    SavedPlace[]
  warehouseViews                 WarehouseView[]
  diadiemNotifications           DiadiemNotification[]         @relation("DiadiemNotifications")
  qrTokensUsed                   QrToken[]                     @relation("UserQrTokensUsed")
  voucherTemplatesApproved       VoucherTemplate[]             @relation("VoucherTemplateApprovedBy")

  // Multiverse - Mission System
  missionsAssigned   Mission[]           @relation("MissionAssignedTo")
  missionsClaimed    Mission[]           @relation("MissionClaimedBy")
  missionsCreated    Mission[]           @relation("MissionCreatedBy")
  missionSubmissions MissionSubmission[] @relation("MissionSubmissionSubmittedBy")
  missionReviews     MissionReview[]     @relation("MissionReviewReviewer")

  // Multiverse - Community Conversations
  communityMessagesAuthored           CommunityMessage[]                 @relation("CommunityMessageAuthor")
  communityConversationParticipations CommunityConversationParticipant[] @relation("CommunityConversationParticipants")

  // Multiverse - Notification Preferences
  notificationPreferences NotificationPreference[] @relation("UserNotificationPreferences")

  // Multiverse - Executive Audit View (immutable)
  executiveAuditViewsAsActor  ExecutiveAuditView[] @relation("ExecutiveAuditViewActor")
  executiveAuditViewsAsTarget ExecutiveAuditView[] @relation("ExecutiveAuditViewTargetUser")

  // Business Registration Form Relations
  businessForms                             BusinessForm[]                     @relation("BusinessFormSubmitter")
  reviewedBusinessForms                     BusinessForm[]                     @relation("BusinessFormReviewer")
  authoredBusinessFormProgressNotes         BusinessFormProgressNote[]         @relation("BusinessFormProgressAuthor")
  adminCreatedBusinessForms                 BusinessForm[]                     @relation("BusinessFormAdminCreator")
  uploadedBusinessFormAttachments           BusinessFormAttachment[]           @relation("BusinessFormAttachmentUploader")
  verifiedBusinessFormAttachments           BusinessFormAttachment[]           @relation("BusinessFormAttachmentVerifier")
  assignedBusinessForms                     BusinessForm[]                     @relation("BusinessFormAssignee")
  assignedByMeBusinessForms                 BusinessForm[]                     @relation("BusinessFormAssigner")
  authoredBusinessFormRiskFlags             BusinessFormRiskFlag[]             @relation("BusinessFormRiskFlagAuthor")
  businessFormTaskAssignments               BusinessFormTaskAssignment[]       @relation("BusinessFormTaskAssignee")
  assignedByBusinessFormTasks               BusinessFormTaskAssignment[]       @relation("BusinessFormTaskAssigner")
  createdBusinessFormTasks                  BusinessFormTask[]                 @relation("BusinessFormTaskCreator")
  completedBusinessFormTasks                BusinessFormTask[]                 @relation("BusinessFormTaskCompleter")
  mainAssignedBusinessFormTasks             BusinessFormTask[]                 @relation("BusinessFormTaskMainAssignee")
  authoredBusinessFormTaskActivities        BusinessFormTaskActivity[]         @relation("BusinessFormTaskActivityAuthor")
  onBehalfOfBusinessFormTasks               BusinessFormTask[]                 @relation("BusinessFormTaskOnBehalfOf")
  onBehalfOfBusinessFormTaskActivities      BusinessFormTaskActivity[]         @relation("BusinessFormTaskActivityOnBehalfOf")
  authoredBusinessFormTaskActivityReactions BusinessFormTaskActivityReaction[] @relation("BusinessFormTaskActivityReactionAuthor")
  businessFormTaskPins                      BusinessFormTaskPin[]              @relation("BusinessFormTaskPinner")

  // Half Wallet Relations
  halfWallets          HalfWallet[]          @relation("UserHalfWallets")
  halfTransferRequests HalfTransferRequest[] @relation("UserHalfTransferRequests")
  halfManualsReceived  HalfTransferManual[]  @relation("HalfManualRecipient")
  halfManualsCreated   HalfTransferManual[]  @relation("HalfManualCreatedBy")
  halfWalletLogs       HalfWalletLog[]       @relation("HalfWalletLogActor")

  // Babysitter Flow Relations (v1.2)
  babyRecords     Baby[]           @relation("UserBaby")
  babiesManaged   Baby[]           @relation("BabysitterBabies")
  babyLogActions  BabyLog[]        @relation("BabyLogActor")
  babysitterTasks BabysitterTask[] @relation("BabysitterTasks")

  // Group-Buy Relations (v1.3)
  leaderGroupBuys     GroupBuy[]       @relation("GroupBuyLeader")
  groupBuyMemberships GroupBuyMember[] @relation("UserGroupBuyMemberships")
  groupBuyLogActions  GroupBuyLog[]    @relation("GroupBuyLogActor")

  // Thẻ nhân viên — xem employee-card.prisma
  employeeCards EmployeeCard[] @relation("UserEmployeeCards")

  // Báo cáo hằng ngày — xem daily-report.prisma
  dailyReports DailyReport[] @relation("UserDailyReports")

  // Performance indexes for referral queries
  @@index([referrerId])
  @@index([referrerId, status])
  @@index([referrerId, verificationDate])
  @@index([status, verificationDate])
  @@index([createdAt])
  @@index([email])
  @@index([phoneNumber])
  @@index([status])
  @@index([role])
  @@index([isActive])
  @@index([updatedAt])
  @@index([zuid])
  @@index([lastSeenAt]) // For presence queries
  @@index([businessId])
  // Lọc "tài khoản nào đến từ luồng nào, trong khoảng nào" — câu hỏi truy vết chính.
  @@index([registrationChannel, createdAt])
  // Hàng đợi "tài khoản được gán tài khoản nhà, chờ người vận hành gán đúng người".
  @@index([referrerAssignment, createdAt])
  // @@index([phoneNumber])
  @@map("users")
}

// ============================================================================
// USER ASSIGNMENT - Admin-User Assignment System
// ============================================================================

model UserAssignment {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("UserAssignment", fields: [userId], references: [id], onDelete: Cascade)

  assignedAdminId String
  assignedAdmin   User   @relation("AssignedUsers", fields: [assignedAdminId], references: [id], onDelete: Cascade)

  assignedAt DateTime  @default(now())
  assignedBy String? // Admin who made this assignment
  expiresAt  DateTime? // Optional expiration
  notes      String? // Admin notes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([assignedAdminId])
  @@index([assignedAt])
  @@index([expiresAt])
  @@map("user_assignments")
}

model UserConfig {
  id String @id @default(uuid())

  config Json

  userId String @unique
  user   User   @relation("UserConfigs", fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_configs")
}

model UserReferralClosure {
  id    String @id @default(uuid())
  depth Int // 0 = self, 1 = direct, 2 = indirect, ...

  ancestorId String
  ancestor   User   @relation("Ancestor", fields: [ancestorId], references: [referenceId])

  descendantId String
  descendant   User   @relation("Descendant", fields: [descendantId], references: [referenceId])

  @@unique([ancestorId, descendantId])
  @@index([ancestorId])
  @@index([descendantId])
  @@index([ancestorId, depth]) // Phase 88 D-88-E-4 — per-member-per-depth downline count for Phase 90 QUAL-01/02 cron
  @@map("user_referral_closures")
}

model UserKYC {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation("UserKYC", fields: [userId], references: [id], onDelete: Cascade)

  // Personal Information
  fullName    String
  dateOfBirth DateTime
  nationality String
  address     String

  // KYC Information
  kycNumber  String
  kycFileUrl String? // Single file URL

  // Status
  status  KycStatus @default(pending)
  message String?

  // Timestamps
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?

  reviewedById String?
  reviewedBy   User?    @relation("UserKYCReviewedBy", fields: [reviewedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("user_kyc")
}
