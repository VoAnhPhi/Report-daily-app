// Enums
enum Gender {
  male
  female
  other
  not_known
  prefer_not_to_say
}

enum UserStatus {
  pending
  pending_admin
  pending_kyc
  kyc_submitted
  kyc_changing
  active
  inactive
  marketing // Guest checkout users without KYC
}

enum Role {
  admin
  user
  collaborator
  moderator
  business
  admin_voucher_gvc
}

enum KycStatus {
  pending
  submitted
  approved
  rejected
}

/// Luồng đã tạo ra tài khoản. Ghi NGAY lúc tạo, không suy từ trạng thái về sau —
/// `status` bị đổi liên tục (marketing → kyc_submitted → active) nên không truy vết được.
/// `User.source` KHÔNG thay thế được: nó chỉ phân biệt kiotviet/acta.
enum RegistrationChannel {
  register_web // Tự đăng ký (auth.service register)
  guest_checkout // Tự sinh khi khách vãng lai đặt hàng (e-commerce checkout)
  admin_created // Nhân viên vận hành tạo trong trang quản trị
  business_owner // Tạo kèm khi mở doanh nghiệp
  game_otp // Luồng OTP marketing của game
  partner_api // Đối tác gọi Partner API
  backfill_import // Nhập từ dữ liệu cũ
  kiotviet_import // Đồng bộ từ KiotViet
  unknown // Không biết — KHÔNG BAO GIỜ đoán bừa thành một luồng cụ thể
}

/// Giá trị `registrationChannel` là khai lúc tạo hay suy đoán về sau.
/// Trộn hai loại vào một cột là mất vĩnh viễn khả năng phân biệt "đo được" với "đoán".
enum RegistrationChannelConfidence {
  declared // Mã ghi thẳng lúc tạo tài khoản
  inferred // Suy từ dấu vân tay dữ liệu cũ (email/bio/ngày sinh/đơn hàng)
  unknown // Chưa xác định
}

/// Người giới thiệu đến từ đâu. Bắt buộc phải có, vì từ nay hệ thống TỰ GÁN tài khoản
/// nhà khi khách không mang mã — không ghi lại thì cây tuyến sẽ nói dối rằng tài khoản
/// nhà thật sự đi giới thiệu những người đó, và hoa hồng sẽ tính trên một lời nói dối.
enum ReferrerAssignment {
  user_link // Khách vào bằng link giới thiệu / tự nhập mã
  house_default // Hệ thống tự gán tài khoản nhà vì không có mã
  admin_assigned // Người vận hành gán tay
  none // Luồng miễn trừ, cố ý để trống
}

model User {
  id String @id @default(uuid())

  // KiotViet integration - Tích hợp KiotViet
  kiotVietUserId Int? @unique // ID tài khoản từ KiotViet

  email            String       @unique
  emailVerified    Boolean      @default(false)
  image            String?
  passwordHash     String
  fullName         String
  referenceId      String       @unique
  phoneNumber      String
  dob              DateTime?    @db.Timestamp(6)
  gender           Gender       @default(not_known)
  verificationDate DateTime?    @db.Timestamp(6)
  country          String
  role             Role
  isActive         Boolean      @default(false)
  bio              String?
  website          String?
  zuid             String? // Zalo User ID (ZUID) for ZNS UID-based messaging
  status           UserStatus   @default(pending)
  rejectedReason   String?
  source           OriginSource @default(acta) // Nguồn gốc

  // Multi-tenant scoping — set at registration/claim time; enriched into JWT in Phase 3
  businessId String?

  // Timestamps
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  lastSeenAt DateTime? // Last time user was active (for presence tracking)

  // Authentications
  emailChange       EmailChange?
  emailVerification EmailVerification?
  otpVerification   OtpVerification?
  passwordReset     PasswordReset?
  passwordChangeOtp PasswordChangeOtp?
  withdrawalOtp     WithdrawalOtp?
  apiKeyOtp         ApiKeyOtp?

  sessions Session[]
  accounts Account[]

  // OAuth Relations
  oauthClients       OAuthClient[]
  oauthAccessTokens  OAuthAccessToken[]
  oauthRefreshTokens OAuthRefreshToken[]
  oauthConsents      OAuthConsent[]

  addresses Address[]

  // Profile images
  avatarId String?     @unique
  avatar   Attachment? @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: Cascade)

  oldAvatars Attachment[] @relation("UserOldAvatars")

  coverId String?     @unique
  cover   Attachment? @relation("UserCover", fields: [coverId], references: [id], onDelete: Cascade)

  oldCovers Attachment[] @relation("UserOldCovers")

  // Referrals Section
  referrerId String?
  referrer   User?   @relation("UserReferrals", fields: [referrerId], references: [referenceId])
  referrals  User[]  @relation("UserReferrals")

  // Truy vết nguồn gốc tài khoản (CLAUDE.md — quyết định chủ dự án 2026-09-11).
  // Mặc định `unknown` là CỐ Ý: hàng cũ chưa suy đoán phải nói "không biết", không
  // được mang một giá trị cụ thể mà không ai đo.
  registrationChannel           RegistrationChannel           @default(unknown)
  registrationChannelConfidence RegistrationChannelConfidence @default(unknown)
  referrerAssignment            ReferrerAssignment?

  ancestors   UserReferralClosure[] @relation("Ancestor")
  descendants UserReferralClosure[] @relation("Descendant")

  // ĐIỆN KIẾN CHỦ — mỗi thành viên tối đa một ngôi sao (shrines.acta.vn)
  shrineStar ShrineStar? @relation("UserShrineStar")

  // Social
  posts        Post[]        @relation("UserPosts")
  reactions    Reaction[]    @relation("UserReactions")
  comments     Comment[]     @relation("UserComments")
  commentLikes CommentLike[] @relation("UserCommentLikes")
  savedPosts   SavedPost[]   @relation("UserSavedPosts")
  reposts      Repost[]      @relation("UserReposts")
  followers    Follower[]    @relation("UserFollowersFollowing")
  following    Follower[]    @relation("UserFollowersFollowed")

  // Stories
  stories                Story[]          @relation("UserStories")
  storyViews             StoryView[]      @relation("UserStoryViews")
  storyReplies           StoryReply[]     @relation("UserStoryReplies")
  storyReports           StoryReport[]    @relation("UserStoryReports")
  storyReportResolutions StoryReport[]    @relation("UserStoryReportResolutions")
  closeFriends           CloseFriend[]    @relation("UserCloseFriends")
  closeFriendOf          CloseFriend[]    @relation("UserCloseFriendOf")
  storyAudience          StoryAudience[]  @relation("UserStoryAudience")
  storyExclusions        StoryExclusion[] @relation("UserStoryExclusions")

  // Livestream
