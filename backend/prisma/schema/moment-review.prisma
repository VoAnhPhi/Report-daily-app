enum MomentReviewType {
  create
  update
  delete
}

enum MomentReviewStatus {
  pending
  approved
  rejected
}

model MomentReview {
  id String @id @default(cuid())

  type   MomentReviewType
  status MomentReviewStatus @default(pending)

  // Snapshot of the proposed moment (post) data (full JSON for create/update, null for delete)
  proposedData Json? // Full moment payload
  previousData Json? // Snapshot of current moment state before change (for update/delete)

  // Post (moment) reference (null for create since post doesn't exist yet)
  postId String?
  post   Post?   @relation("PostMomentReviews", fields: [postId], references: [id], onDelete: SetNull)

  // Submitter
  submittedById String
  submittedBy   User     @relation("MomentReviewSubmitter", fields: [submittedById], references: [id])
  submittedAt   DateTime @default(now())

  // Reviewer (filled on approve/reject)
  reviewedById String?
  reviewedBy   User?     @relation("MomentReviewReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  // Reviewer feedback
  reviewNote   String?  @db.Text
  reviewImages String[] // uploadthing URLs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Audit log entries
  auditLogs MomentReviewAuditLog[]

  @@index([status])
  @@index([type])
  @@index([postId])
  @@index([submittedById])
  @@index([reviewedById])
  @@index([createdAt])
  @@map("moment_reviews")
}

model MomentReviewAuditLog {
  id String @id @default(cuid())

  action   String // submitted, approved, rejected, cancelled
  note     String? @db.Text
  metadata Json? // Any extra context

  performedById String
  performedBy   User   @relation("MomentReviewAuditPerformer", fields: [performedById], references: [id])

  reviewId String
  review   MomentReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([reviewId])
  @@index([performedById])
  @@index([action])
  @@index([createdAt])
  @@map("moment_review_audit_logs")
}
