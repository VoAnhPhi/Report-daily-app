enum VoucherReviewType {
  create
  update
  delete
}

enum VoucherReviewStatus {
  pending
  approved
  rejected
}

model VoucherReview {
  id String @id @default(cuid())

  type   VoucherReviewType
  status VoucherReviewStatus @default(pending)

  // Snapshot of the proposed voucher data (full JSON for create/update, null for delete)
  proposedData Json? // Full voucher payload
  previousData Json? // Snapshot of current voucher state before change (for update/delete)

  // VoucherTemplate reference (null for create since voucher doesn't exist yet)
  voucherTemplateId String?
  voucherTemplate   VoucherTemplate? @relation(fields: [voucherTemplateId], references: [id], onDelete: SetNull)

  // Submitter
  submittedById String
  submittedBy   User     @relation("VoucherReviewSubmitter", fields: [submittedById], references: [id])
  submittedAt   DateTime @default(now())

  // Reviewer (filled on approve/reject)
  reviewedById String?
  reviewedBy   User?     @relation("VoucherReviewReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  // Reviewer feedback
  reviewNote   String?  @db.Text
  reviewImages String[] // uploadthing URLs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Audit log entries
  auditLogs VoucherReviewAuditLog[]

  @@index([status])
  @@index([type])
  @@index([voucherTemplateId])
  @@index([submittedById])
  @@index([reviewedById])
  @@index([createdAt])
  @@map("voucher_reviews")
}

model VoucherReviewAuditLog {
  id String @id @default(cuid())

  action   String // submitted, approved, rejected, cancelled
  note     String? @db.Text
  metadata Json? // Any extra context

  performedById String
  performedBy   User   @relation("VoucherReviewAuditPerformer", fields: [performedById], references: [id])

  reviewId String
  review   VoucherReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([reviewId])
  @@index([performedById])
  @@index([action])
  @@index([createdAt])
  @@map("voucher_review_audit_logs")
}
