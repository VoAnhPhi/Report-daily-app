// ============================================================================
// Product Availability Subscription - Đăng ký thông báo khi sản phẩm mở bán
// ============================================================================

enum ProductAvailabilitySubscriptionType {
  BACK_IN_STOCK
  OPEN_SALE
}

enum ProductAvailabilitySubscriptionStatus {
  ACTIVE
  SENT
  UNSUBSCRIBED
}

model ProductAvailabilitySubscription {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sentAt    DateTime?

  email  String
  userId String?
  user   User?   @relation("UserProductAvailabilitySubscriptions", fields: [userId], references: [id], onDelete: SetNull)

  productId String
  product   Product @relation("ProductAvailabilitySubscriptions", fields: [productId], references: [id], onDelete: Cascade)

  type   ProductAvailabilitySubscriptionType   @default(OPEN_SALE)
  status ProductAvailabilitySubscriptionStatus @default(ACTIVE)

  unsubscribeToken String? @unique

  @@unique([email, productId, type, status])
  @@index([productId, status])
  @@index([email])
  @@map("product_availability_subscriptions")
}
