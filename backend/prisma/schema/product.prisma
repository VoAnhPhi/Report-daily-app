model ProductBatchExpire {
  id String @id @default(cuid())

  // KiotViet integration fields
  kiotVietBatchExpireId Int? // ID lô hàng từ KiotViet
  kiotVietProductId     Int? // ID sản phẩm từ KiotViet
  kiotVietWarehouseId   Int? // ID kho hàng từ KiotViet

  onHand          Int          @default(0) // Số lượng tồn kho
  batchName       String // Tên lô hàng
  manufactureDate DateTime? // Ngày sản xuất
  expireDate      DateTime? // Ngày hết hạn
  fullNameVirgule String? // Tên đầy đủ có dấu phẩy
  source          OriginSource @default(acta) // Nguồn gốc

  // Cọc theo lô khi nhập vào kho CTV
  hasDeposit      Boolean  @default(false) // Có cọc hay không
  depositAmount   Decimal? @db.Decimal(15, 2) // Số tiền cọc (nếu có)
  depositNote     String? // Ghi chú cọc
  // Hoàn cọc: tổng đã hoàn (luỹ kế) + lịch sử từng lần (JSONB, không bảng riêng).
  // Mỗi phần tử depositRefunds: { amount, note, refundedById, refundedByName, at }
  depositRefunded Decimal  @default(0) @db.Decimal(15, 2) // Tổng đã hoàn cọc
  depositRefunds  Json? // Lịch sử hoàn cọc

  /// Số suất cọc của dòng này ĐÃ bán ra. Suất còn lại = `onHand − depositConsumed`.
  /// Chỉ có nghĩa với dòng cọc cấp combo (`hasDeposit` + `depositAmount > 0`);
  /// dòng lô hàng lẻ không bao giờ bị trừ vì hàng lẻ luôn sinh thù lao kho vận,
  /// không phụ thuộc cọc. Xem `deposit-quota.prisma`.
  depositConsumed Int @default(0)

  /// Optimistic lock — cùng kỷ luật với `ProductComboEarmark.version` và
  /// `ProductInventory.version` (INV-01). Bump ở mọi lần CAS `depositConsumed`.
  version Int @default(0)

  /// Từng lần một đơn hàng lấy suất cọc ra khỏi dòng này — nguồn để hoàn suất
  /// chính xác và idempotent khi đơn bị huỷ.
  depositAllocations OrderDepositAllocation[]

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  warehouseId String // ID kho hàng
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  invoiceDetails InvoiceDetail[]

  purchaseOrderDetails PurchaseOrderDetail[]

  createdAt DateTime @default(now())

  @@unique([warehouseId, productId, batchName]) // FEFO/lot theo kho–sản phẩm–lô
  @@index([kiotVietBatchExpireId])
  @@index([kiotVietProductId])
  @@index([kiotVietWarehouseId])
  @@index([productId])
  @@index([onHand])
  @@index([batchName])
  @@index([expireDate])
  @@index([fullNameVirgule])
  @@index([warehouseId])
  @@map("product_batch_expires")
}

