model ZaloIntegration {
  id                    String   @id @default(cuid())
  accessToken           String
  refreshToken          String
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("zalo_integrations")
}

model ZaloTemplate {
  id          String   @id @default(cuid())
  templateId  String   @unique
  code        String   @unique // Flow identifier: e.g., "sendInformationAccount", "registration"
  name        String
  description String?
  fields      Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([code])
  @@map("zalo_templates")
}
