model Category {
  id String @id @default(cuid())

  // KiotViet integration - Tích hợp KiotViet
  kiotVietCategoryId Int?     @unique // ID danh mục từ KiotViet
  kiotVietParentId   Int? // ID danh mục cha từ KiotViet
  hasChild           Boolean? // Có danh mục con (từ KiotViet)

  // Thông tin cơ bản
  name           String // Tên danh mục
  nameNormalized String? // STORED generated column — managed via raw migration SQL; do NOT use prisma migrate dev
  slug           String  @unique // URL thân thiện
  description    String? // Mô tả
  image          String? // Hình ảnh
  icon           String? // Biểu tượng
  color          String? // Màu sắc
  isActive       Boolean @default(true) // Trạng thái hoạt động
  sortOrder      Int     @default(0) // Thứ tự sắp xếp

  // Thông tin về danh mục
  source OriginSource @default(acta) // Nguồn gốc
  isRoot Boolean      @default(false) // Là danh mục gốc

  // Hierarchy - Phân cấp danh mục
  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  // Relationships - Các mối quan hệ
  products         Product[] @relation("ProductLegacyCategory") // Danh sách sản phẩm (legacy)
  primaryProducts  Product[] @relation("ProductPrimaryCategory") // Sản phẩm chọn đây là danh mục chính
  featuredProducts Product[] @relation("FeaturedCategories") // Danh sách sản phẩm nổi bật

  invoiceDetails InvoiceDetail[]

  // Affiliate commissions
  affiliateCommissions AffiliateCommission[]

  // Category Reviews
  categoryReviews CategoryReview[]

  // Phase 30 — back-relation từ BusinessBrandFeaturedCategory
  featuredInBrands BusinessBrandFeaturedCategory[]

  // Phase 30 — back-relation từ CategoryAuditLog
  auditLogs CategoryAuditLog[]

  // Phase 37 — halfvec(1024) embedding (catalog-wide scan). Managed via raw migration SQL
  // (Prisma --create-only). Phase 37 pipeline owns population; unindexed (small table).
  embedding        Unsupported("halfvec(1024)")?
  embeddingVersion String?                       @map("embedding_version")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([slug])
  @@index([kiotVietCategoryId])
  @@index([kiotVietParentId])
  @@index([hasChild])
  @@index([parentId])
  @@index([isActive])
  @@map("categories")
}
